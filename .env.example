# Copy to .env.local. `neon env pull` fills the Neon values once the project is linked.
# On Vercel, set every variable marked [vercel] for Production (and Preview if you use it).

# Postgres. The pooled URL serves the app [vercel]; the unpooled one is only for `drizzle-kit migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth [vercel]. Add each deployed domain to the trusted domains in the Neon console.
NEON_AUTH_BASE_URL=
# At least 32 characters: openssl rand -base64 32. Keep it stable or every session signs out. [vercel]
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage for photos, from `neon env pull` [vercel]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Claude, server-side only [vercel]. A key not scoped to a workspace also needs the workspace ID (wrkspc_...).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
